include(clang-base)

[settings]
build_type=Debug
compiler.sanitizer=AddressUndefinedBehavior

[conf]
tools.build:cxxflags=["-stdlib=libc++", "-fsanitize=address,undefined", "-fno-omit-frame-pointer", "-g"]
tools.build:cflags=["-stdlib=libc++", "-fsanitize=address,undefined", "-fno-omit-frame-pointer", "-g"]
tools.build:exelinkflags=["-stdlib=libc++", "-fsanitize=address,undefined"]

[runenv]
ASAN_OPTIONS=halt_on_error=1:detect_leaks=1

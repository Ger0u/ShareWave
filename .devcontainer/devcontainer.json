{
  "name": "ShareWave",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "runArgs": ["--name", "sharewave-dev"],
  "customizations": {
    "vscode": {
      "extensions": [
        "github.vscode-github-actions",
        "llvm-vs-code-extensions.vscode-clangd",
        "ms-vscode.cmake-tools",
        "unifiedjs.vscode-mdx"
      ],
      "settings": {
        "clangd.arguments": [
          "--compile-commands-dir=${containerWorkspaceFolder}/build/clang/Debug"
        ],
        "clangd.onConfigChanged": "restart"
      }
    }
  },
  "mounts": [
    "source=sharewave-conan-cache,target=/root/.conan2,type=volume"
  ],
  "postStartCommand": "bash /workspaces/ShareWave/scripts/build-profile.sh clang-debug"
}
